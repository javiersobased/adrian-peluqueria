+# Supabase (ya existentes)
+VITE_SUPABASE_URL=
+VITE_SUPABASE_ANON_KEY=
+
+# --- Reservas / Admin como sitios independientes ---
+#
+# Este mismo código se despliega DOS VECES (dos proyectos de Vercel distintos
+# con dominios distintos), y estas variables le dicen a cada uno qué debe mostrar.
+#
+# VITE_APP_MODE: "booking" o "admin"
+#   - booking -> muestra solo el flujo de reservas (Landing, pasos, etc.)
+#   - admin   -> muestra solo el panel de administración
+#   - si se deja vacío, se comporta como antes (todo en un sitio, #admin para entrar)
+VITE_APP_MODE=booking
+
+# VITE_APP_TITLE: título de pestaña / nombre "app" en iOS al añadir a inicio
+VITE_APP_TITLE="Reservas · Adrián Millán"
+
+# URL pública del sitio de RESERVAS (para que el botón "volver al inicio" del
+# panel admin te lleve ahí en vez de a un #hash inexistente en su propio dominio)
+VITE_BOOKING_URL=https://reservas.adrianmillan.es
+
+# URL pública del sitio de ADMIN (para el acceso a admin desde la web de reservas)
+VITE_ADMIN_URL=https://admin.adrianmillan.es
