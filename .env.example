# Supabase Configuration
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Modo SaaS multi-tenant. Mantener en false hasta completar los pasos 3-6 de la migración.
VITE_SAAS_MODE=false

# Solo en el entorno Preview de Vercel: dominio registrado que resuelven los *.vercel.app de preview.
# VITE_TENANT_PREVIEW_HOST=www.adrianmillan.es

